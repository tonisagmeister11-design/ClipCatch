<Window x:Class="ClipCatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipCatch" Width="460" Height="780" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource Bg}" Icon="Assets/clipcatch.ico"
        WindowStyle="None" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="14,0,4,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/clipcatch-256.png" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="ClipCatch" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeButton}" Click="OpenFolder_Click" ToolTip="Aufnahme-Ordner öffnen">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" />
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimieren">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE921;" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="Schließen">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8BB;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Everything below the title bar scrolls on small screens and fills the window otherwise. -->
            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=Scroller}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="220" />
            </Grid.RowDefinitions>

            <!-- Record button -->
            <StackPanel Grid.Row="0" Margin="20,10,20,18">
                <Button x:Name="RecordButton" Click="Record_Click" Height="64" Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource RecordGradient}" CornerRadius="16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFE42A5C" BlurRadius="24" ShadowDepth="0" Opacity="0.45" />
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="26" Height="26" Margin="0,0,12,0">
                                        <Ellipse Stroke="White" StrokeThickness="2.5" />
                                        <Ellipse Fill="White" Margin="6" />
                                    </Grid>
                                    <TextBlock Text="Aufnahme" Foreground="White" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Settings -->
            <StackPanel Grid.Row="1" Margin="20,0,20,16">
                <TextBlock Style="{StaticResource SectionTitle}" Text="EINSTELLUNGEN" />
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Bildrate" VerticalAlignment="Center" FontSize="13" />
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Fps30" Style="{StaticResource Segment}" GroupName="fps" Content="30 FPS" Tag="30" Checked="Fps_Checked" />
                                    <RadioButton x:Name="Fps60" Style="{StaticResource Segment}" GroupName="fps" Content="60 FPS" Tag="60" Checked="Fps_Checked" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Auflösung" VerticalAlignment="Center" FontSize="13" />
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal" x:Name="ResolutionPanel">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="res" Content="Original" Tag="Original" Checked="Resolution_Checked" ToolTip="So viele Pixel wie der markierte Bereich" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="res" Content="720p" Tag="P720" Checked="Resolution_Checked" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="res" Content="1080p" Tag="P1080" Checked="Resolution_Checked" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="res" Content="1440p" Tag="P1440" Checked="Resolution_Checked" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="res" Content="4K" Tag="P2160" Checked="Resolution_Checked" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Qualität" VerticalAlignment="Center" FontSize="13" />
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal" x:Name="QualityPanel">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="q" Content="Standard" Tag="Standard" Checked="Quality_Checked" ToolTip="Kleinere Dateien" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="q" Content="Hoch" Tag="High" Checked="Quality_Checked" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="q" Content="Maximal" Tag="Maximum" Checked="Quality_Checked" ToolTip="Beste Qualität für den Schnitt, größere Dateien" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,12" />

                        <CheckBox x:Name="SystemAudioBox" Style="{StaticResource Switch}" Content="Systemton aufnehmen" Margin="0,0,0,10" Click="Toggle_Click" />
                        <CheckBox x:Name="MicBox" Style="{StaticResource Switch}" Content="Mikrofon aufnehmen" Margin="0,0,0,10" Click="Toggle_Click" />
                        <CheckBox x:Name="CursorBox" Style="{StaticResource Switch}" Content="Mauszeiger zeigen" Margin="0,0,0,10" Click="Toggle_Click" />
                        <CheckBox x:Name="ClicksBox" Style="{StaticResource Switch}" Content="Mausklicks hervorheben" Margin="0,0,0,10" Click="Toggle_Click" />
                        <CheckBox x:Name="CountdownBox" Style="{StaticResource Switch}" Content="Countdown 3 – 2 – 1" Margin="0,0,0,12" Click="Toggle_Click" />

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Speicherort" FontSize="13" />
                                <TextBlock x:Name="FolderText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,8,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Click="ChangeFolder_Click" Background="#FF2A2A33">
                                <TextBlock Text="Ändern" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Recordings -->
            <Grid Grid.Row="2" Margin="20,0,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="AUFNAHMEN" />
                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" FontSize="11" Margin="0,1,2,0"
                               Text="Zum Bearbeiten einfach in Premiere ziehen" />
                </Grid>

                <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Top" Panel.ZIndex="1" Margin="0,-4,0,0"
                        Background="#FF1E3A2B" BorderBrush="#FF2F6B48" BorderThickness="1" CornerRadius="10" Padding="12,8"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" Foreground="#FF5BD68A" Margin="0,0,8,0" />
                        <TextBlock x:Name="ToastText" Text="Aufnahme gespeichert" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="RecordingsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                         ItemContainerStyle="{StaticResource RecordingItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="List_PreviewMouseMove" MouseDoubleClick="List_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="Doppelklick = abspielen · in ein anderes Programm ziehen = Datei übergeben">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource AccentSoft}" Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE714;" Foreground="{StaticResource Accent}" FontSize="16" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="NEU" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource FlatButton}" Padding="7" Click="Play_Click" Tag="{Binding}" ToolTip="Abspielen">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" />
                                    </Button>
                                    <Button Style="{StaticResource FlatButton}" Padding="7" Click="SaveAs_Click" Tag="{Binding}" ToolTip="Speichern unter … (herunterladen)">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" />
                                    </Button>
                                    <Button Style="{StaticResource FlatButton}" Padding="7" Click="Copy_Click" Tag="{Binding}" ToolTip="Datei kopieren (zum Einfügen im Explorer oder in Premiere)">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" />
                                    </Button>
                                    <Button Style="{StaticResource FlatButton}" Padding="7" Click="Reveal_Click" Tag="{Binding}" ToolTip="Im Ordner zeigen">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" />
                                    </Button>
                                    <Button Style="{StaticResource FlatButton}" Padding="7" Click="Delete_Click" Tag="{Binding}" ToolTip="In den Papierkorb">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE714;" FontSize="30" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Noch keine Aufnahmen.&#x0a;Klick auf „Aufnahme“, markiere einen Bereich und los geht's." />
                </StackPanel>
            </Grid>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
