<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 (1903+) and 11: nothing extra to install.
         ScreenRecorderLib is a .NET Framework C++/CLI assembly, so this is also what it needs. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>ClipCatch</RootNamespace>
    <AssemblyName>ClipCatch</AssemblyName>
    <Version>1.0.0</Version>
    <Product>ClipCatch</Product>
    <Description>ClipCatch – Bildschirmaufnahme</Description>
    <Copyright>MIT License</Copyright>
    <ApplicationIcon>Assets\clipcatch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ScreenRecorderLib ships one native build per platform. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Lets the project build (not run) on Linux and macOS too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\clipcatch.ico" />
    <Resource Include="Assets\clipcatch-256.png" />
  </ItemGroup>

</Project>
