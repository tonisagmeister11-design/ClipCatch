<Window x:Class="ClipCatch.SelectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipCatch – Bereich wählen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Width="400" Height="300" Left="0" Top="0"
        Cursor="Cross" FocusManager.IsFocusScope="True"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}">
    <Grid x:Name="Root" Background="#01000000">
        <Path x:Name="Shade" Fill="#99000000" IsHitTestVisible="False" />

        <Canvas x:Name="Layer">
            <Rectangle x:Name="Frame" Stroke="{StaticResource Accent}" StrokeThickness="2"
                       Visibility="Collapsed" IsHitTestVisible="False" />

            <Border x:Name="SizeLabel" Background="#E61F1F26" CornerRadius="6" Padding="8,3"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" FontSize="12" FontFamily="Consolas, Segoe UI" />
            </Border>

            <Border x:Name="Toolbar" Background="#F21F1F26" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="12" Padding="6" Visibility="Collapsed" Cursor="Arrow">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Padding="14,8" Click="Start_Click"
                            ToolTip="Aufnahme starten (Enter)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Start" Foreground="White" FontSize="13.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <Button Style="{StaticResource FlatButton}" Click="FullScreen_Click" ToolTip="Ganzen Bildschirm aufnehmen (Doppelklick)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE740;" Margin="0,0,6,0" />
                            <TextBlock Text="Ganzer Bildschirm" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Cancel_Click" ToolTip="Abbrechen (Esc)" Margin="2,0,0,0">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" />
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>

        <Border x:Name="Hint" Background="#E61F1F26" CornerRadius="12" Padding="18,12"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="Bereich mit der Maus aufziehen" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Text="Doppelklick = ganzer Bildschirm  ·  Esc = abbrechen" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
